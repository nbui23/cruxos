generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String?
  isDemo            Boolean           @default(false)
  passwordHash      String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sessions          AuthSession[]
  climbingSessions  ClimbingSession[]
  sleepEntries      SleepEntry[]
  nutritionEntries  NutritionEntry[]
  bodyweightEntries BodyweightEntry[]
  hangboardSessions HangboardSession[]
  fingerRehabEntries FingerRehabEntry[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ClimbingSession {
  id              String   @id @default(cuid())
  userId          String
  sessionDate     DateTime
  discipline      String?
  gradeScale      String   @default("BOULDER_V")
  hardestGrade    String
  normalizedGrade Int
  sessionRpe      Int?
  sendCount       Int?
  attemptCount    Int?
  durationMinutes Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionDate])
}

model SleepEntry {
  id           String   @id @default(cuid())
  userId       String
  entryDate    DateTime
  hours        Float
  qualityScore Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
}

model NutritionEntry {
  id           String   @id @default(cuid())
  userId       String
  entryDate    DateTime
  proteinGrams Int
  calories     Int?
  hydration    Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
}

model BodyweightEntry {
  id        String   @id @default(cuid())
  userId    String
  entryDate DateTime
  weightLbs Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
}

model HangboardSession {
  id              String   @id @default(cuid())
  userId          String
  sessionDate     DateTime
  protocolName    String
  durationMinutes Int?
  intensity       Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionDate])
}

model FingerRehabEntry {
  id             String   @id @default(cuid())
  userId         String
  entryDate      DateTime
  painScore      Int
  rehabCompleted Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
}
